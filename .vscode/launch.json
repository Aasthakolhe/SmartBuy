{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SmartBuy (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train models",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
